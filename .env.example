# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored, `.env.example` is committed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | production
# production switches session cookies to Secure by default.
APP_ENV=development
# Quote values that contain spaces.
APP_NAME="Rust Askama"

# IANA timezone used to render every timestamp in the UI.
# Examples: Asia/Kolkata, UTC, Europe/Berlin, America/New_York
APP_TIMEZONE=Asia/Kolkata

# --- HTTP server -----------------------------------------------------------
HOST=127.0.0.1
PORT=3000
STATIC_DIR=static

# Trust X-Forwarded-For / X-Real-IP for the client IP.
# Enable ONLY when the app sits behind a proxy you control, otherwise clients
# can spoof their address.
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rust-axum-askama

# Maintenance database used only to run `CREATE DATABASE` when DB_NAME is missing.
DB_ADMIN_NAME=postgres

# Extra connection options, e.g. `sslmode=require`. Leave empty for local dev.
DB_OPTIONS=

# Create the database automatically on boot when it does not exist.
DB_AUTO_CREATE=true
# Apply pending migrations on boot.
DB_RUN_MIGRATIONS=true

DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT_SECS=8

# Optional: a full connection string overrides every DB_* value above.
# Managed platforms usually inject this for you.
# DATABASE_URL=postgres://user:password@host:5432/database

# --- Redis (only used when SESSION_STORE=redis) -----------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 6+ ACL user. Leave empty for the default user.
REDIS_USERNAME=
# `requirepass` / ACL password. Leave empty if your local Redis has no auth.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rust_askama:session:

# Optional: a full URL overrides every REDIS_* value above.
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- Sessions --------------------------------------------------------------
# postgres | redis
SESSION_STORE=postgres
SESSION_COOKIE_NAME=rust_askama_sid
# Sliding inactivity window, in minutes.
SESSION_TTL_MINUTES=1440
# Defaults to true in production, false in development. MUST be true over HTTPS.
SESSION_COOKIE_SECURE=false
# How often expired session rows are purged, in seconds.
SESSION_CLEANUP_INTERVAL_SECS=600

# --- Development ------------------------------------------------------------
# Browser live reload. Enabled by default outside production.
DEV_LIVE_RELOAD=true
# Comma-separated directories watched for asset changes.
DEV_WATCH_PATHS=static,templates

# --- Logging ---------------------------------------------------------------
RUST_LOG=rust_askama=debug,tower_http=info,sea_orm=warn,info
